    "data.storage.local" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Maps, positions, relations, and history are stored locally and excluded from new OS backups. This app cannot remove copies in older backups." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지도·위치·관계·기록은 기기에 저장하며 새 OS 백업에서는 제외합니다. 이전 백업에 담긴 사본은 앱에서 삭제할 수 없습니다." } }
      }
    },
