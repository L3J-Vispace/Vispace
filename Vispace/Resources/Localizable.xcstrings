    "onboarding.guide.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use the furniture button to check a sofa, bed, or desk. Ask to navigate only after the floor and passage have been scanned." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "가구 버튼으로 소파·침대·책상을 놓을 자리를 확인하세요. 바닥과 통로를 충분히 비춘 뒤 길 안내를 요청할 수 있어요." } }
      }
    },
    "onboarding.guide.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Try placement and safe routes" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "배치 추천과 안전 경로를 확인하세요" } }
      }
    },
    "onboarding.memory.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep an object in view from a few angles. Vispace saves only confirmed spatial facts and clearly marks uncertain results." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "물체를 여러 각도에서 잠시 비춰 주세요. 확인된 공간 정보만 저장하고 불확실한 결과는 분명히 표시합니다." } }
      }
    },
    "onboarding.memory.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Build a reliable spatial memory" } },
