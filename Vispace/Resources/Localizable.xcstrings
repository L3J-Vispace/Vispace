    "onboarding.scan.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold your iPhone upright and slowly scan the floor, walls, and objects from several angles. Vispace remembers only confirmed spatial information and marks uncertain results."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 세로로 들고 바닥·벽·물체를 여러 각도에서 천천히 비춰 주세요. 확인된 공간 정보만 기억하고, 불확실한 결과는 따로 알려드려요."
          }
