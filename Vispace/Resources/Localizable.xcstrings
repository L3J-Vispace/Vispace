      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ask things like “Where is my phone?”, “What is on the desk?”, or “Where was my laptop last seen?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“휴대폰 어디 있어?”, “책상 위에 뭐가 있어?”, “노트북을 마지막으로 어디에서 봤어?”처럼 물어보세요." } }
