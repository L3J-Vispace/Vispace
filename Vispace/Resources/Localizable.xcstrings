{
  "sourceLanguage" : "en",
  "strings" : {
    "storage.restore.failed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Saved space could not be restored. Existing files are preserved. Check storage and the app version, then reopen the app to retry." } },
        "ko": { "stringUnit": { "state": "translated", "value": "저장된 공간을 불러오지 못했어요. 기존 파일은 보존됩니다. 저장 공간과 앱 버전을 확인한 뒤 앱을 다시 열어 주세요." } }
      }
    },
    "storage.save.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Spatial data could not be saved. Open storage settings, free some space and retry scanning."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "공간 정보를 저장하지 못했어요. 저장공간을 확인하고 정리한 뒤 다시 스캔해 주세요."
        }
      }
    }
  },
  "storage.objects.full": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Object memory is full. Existing objects still update. Manage saved places to add new objects."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "물체 기록이 가득 찼어요. 기존 물체는 계속 갱신됩니다. 새 물체를 추가하려면 장소를 정리해 주세요."
        }
      }
    }
  },
  "placement.dimensions.title": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Furniture dimensions"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "가구 실측 치수"
        }
      }
    }
  },
  "placement.dimensions.metres": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Dimensions in metres"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "치수 입력 단위 m"
        }
      }
    }
  },
  "placement.dimensions.detail": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Enter the actual product dimensions, between 0.1 and 10 metres. Initial values are examples."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "실제 제품의 치수를 0.1~10m 범위로 입력해 주세요. 처음 표시된 값은 예시입니다."
        }
      }
    }
  },
  "placement.width": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Width"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "너비"
        }
      }
    }
  },
  "placement.depth": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Depth"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "깊이"
        }
      }
    }
  },
  "placement.height": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Height"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "높이"
        }
      }
    }
  },
  "placement.evaluate": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Check placement"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "배치 확인"
        }
      }
    }
  },
  "data.storage.usage": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Storage usage"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "저장공간 사용량"
        }
      }
    }
  },
  "data.storage.used": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Used by Vispace"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "Vispace 사용량"
        }
      }
    }
  },
  "data.storage.available": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Device space available"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "기기 여유 공간"
        }
      }
    }
  },
  "data.storage.budget": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Spatial storage is limited to 512 MB. Saving preserves at least 128 MB of device free space."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "공간 데이터는 최대 512MB로 관리하며, 저장 시 기기 여유 공간 128MB를 확보합니다."
        }
      }
    }
  },
  "data.places.title": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Saved places"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "저장된 장소"
        }
      }
    }
  },
  "data.place.delete": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Delete this place"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 장소 삭제"
        }
      }
    }
  },
  "data.place.delete.detail": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This removes the selected map, objects, history and related alignments. Other places remain available. Use Delete All to also remove unreadable recovery files."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "선택한 지도의 물체, 이력, 관련 좌표 연결을 함께 삭제합니다. 다른 장소는 유지합니다. 해석할 수 없는 복구 파일까지 지우려면 전체 삭제를 이용해 주세요."
        }
      }
    }
  },
  "data.place.select": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Restore this place"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 장소 복원"
        }
      }
    }
  },
  "data.place.select.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This place could not be restored. Check its saved data and try again."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "장소를 복원하지 못했어요. 저장된 데이터를 확인하고 다시 시도해 주세요."
        }
      }
    }
  },
  "data.storage.read.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Saved data could not be read. A newer app version may be required; keep the data until its version is checked."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "저장된 데이터를 읽지 못했어요. 더 최신 앱이 필요할 수 있으니 버전을 확인하기 전에는 데이터를 보존해 주세요."
        }
      }
    }
  },
  "data.support.title": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Supported features"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "지원 범위"
        }
      }
    }
  },
  "data.support.objects": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Detection supports model classes such as chairs, sofas, beds, desks, bottles and laptops. Keys and wallets are not supported."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "의자, 소파, 침대, 책상, 병, 노트북 등 모델에 포함된 종류를 인식합니다. 열쇠와 지갑은 지원하지 않습니다."
        }
      }
    }
  },
  "data.support.device": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Saving new 3D objects requires verified depth. Placement and route guidance require LiDAR."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "새 3D 물체 저장에는 검증된 깊이 정보가 필요합니다. 배치와 경로 안내에는 LiDAR가 필요합니다."
        }
      }
    }
  },
  "data.support.routes": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Guidance covers observed indoor floors only. Doors, steps, stairs and unseen areas can prevent a route. Keep checking your surroundings."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "관측한 실내 바닥에서 안내합니다. 문, 단차, 계단, 보이지 않는 구역에서는 경로가 제공되지 않을 수 있습니다. 주변을 직접 확인해 주세요."
        }
      }
    }
  },
    "command.empty" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter an object or a placement question." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "찾을 물건이나 배치할 가구를 입력해 주세요." } }
      }
    },
    "command.tooLong" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your request within 256 characters." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "요청을 256자 이내로 입력해 주세요." } }
      }
    },
    "command.ambiguousFurniture" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose one furniture item to check at a time." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한 번에 가구 하나를 선택해 배치를 확인해 주세요." } }
      }
    },
    "command.negatedPlacement" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No placement was started. Use the furniture menu when you want to check a position." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "배치를 실행하지 않았어요. 위치를 확인하려면 가구 메뉴에서 하나를 선택해 주세요." } }
      }
    },
    "command.unsupportedFurniture" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Placement checks currently support sofas, beds and desks." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 배치 확인은 소파, 침대, 책상을 지원해요." } }
      }
    },
    "storage.unavailable.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Spatial storage is unavailable" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공간 데이터를 안전하게 저장할 수 없어요" } }
      }
    },
    "storage.unavailable.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Capture is paused because data protection could not be prepared. Retry after unlocking your iPhone. Existing data has not been deleted." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "데이터 보호 설정을 적용하지 못해 촬영을 멈췄어요. 아이폰 잠금을 해제한 뒤 다시 시도해 주세요. 기존 데이터는 삭제하지 않았어요." } }
      }
    },
    "camera.accessibility.hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move your iPhone slowly to show the surrounding space."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 천천히 움직여 주변 공간을 비춰 주세요."
          }
        }
      }
    },
    "camera.accessibility.label" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live camera"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 카메라"
          }
        }
      }
    },
    "camera.permissionDenied.action" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 열기"
          }
        }
      }
    },
    "camera.permissionDenied.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow camera access in Settings to use Vispace."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vispace를 사용하려면 설정에서 카메라 접근을 허용해 주세요."
          }
        }
      }
    },
    "camera.permissionDenied.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is off"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 접근이 꺼져 있어요"
          }
        }
      }
    },
    "camera.failed.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The camera session stopped, so spatial tracking is paused. Try again, or manage the spatial data already stored on this iPhone." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "카메라 세션이 중단되어 공간 추적을 멈췄어요. 다시 시도하거나 이 iPhone에 저장된 공간 데이터를 관리할 수 있어요." } }
      }
    },
    "camera.failed.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera session stopped" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "카메라 세션이 중단됐어요" } }
      }
    },
    "camera.recovery.manageData" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage Spatial Data" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공간 데이터 관리" } }
      }
    },
    "camera.recovery.retry" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Try Again" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 시도" } }
      }
    },
    "camera.unavailable.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The required AR tracking could not start on this iPhone. You can retry or manage saved spatial data without camera access." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 iPhone에서 필요한 AR 추적을 시작하지 못했어요. 다시 시도하거나 카메라 접근 없이 저장된 공간 데이터를 관리할 수 있어요." } }
      }
    },
    "camera.unavailable.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Spatial camera is unavailable" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공간 카메라를 사용할 수 없어요" } }
      }
    },
    "confidence.high" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확실"
          }
        }
      }
    },
    "confidence.low" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불확실"
          }
        }
      }
    },
    "confidence.medium" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medium"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능성 있음"
          }
        }
      }
    },
    "data.delete.action" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete All Spatial Data" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공간 데이터 모두 삭제" } }
      }
    },
    "data.delete.confirm.action" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete Permanently" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "완전히 삭제" } }
      }
    },
    "data.delete.confirm.cancel" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "취소" } }
      }
    },
    "data.delete.confirm.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved maps, object positions, scene relations, and history will be removed from this iPhone. This cannot be undone." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 지도, 물체 위치, 공간 관계와 기록이 이 iPhone에서 삭제됩니다. 이 작업은 되돌릴 수 없습니다." } }
      }
    },
    "data.delete.confirm.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete all spatial data?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 공간 데이터를 삭제할까요?" } }
      }
    },
    "data.delete.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Deletion pauses capture, removes Vispace’s dedicated spatial-data folder, and starts a new empty mapping session." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "삭제하는 동안 촬영을 멈추고 Vispace 전용 공간 데이터 폴더를 비운 뒤 새 지도 세션을 시작합니다." } }
      }
    },
    "data.delete.failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Spatial data could not be deleted. Try again." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공간 데이터를 삭제하지 못했습니다. 다시 시도해 주세요." } }
      }
    },
    "data.delete.progress" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Deleting spatial data…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공간 데이터 삭제 중…" } }
      }
    },
    "data.delete.success" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "All spatial data was deleted. A new mapping session has started." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공간 데이터를 모두 삭제하고 새 지도 세션을 시작했습니다." } }
      }
    },
    "data.done" : {
      "localizations" : {
