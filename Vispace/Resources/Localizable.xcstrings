    "storage.unavailable.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Capture is paused because data protection could not be prepared. Retry after unlocking your iPhone. Existing data has not been deleted." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "데이터 보호 설정을 적용하지 못해 촬영을 멈췄어요. 아이폰 잠금을 해제한 뒤 다시 시도해 주세요. 기존 데이터는 삭제하지 않았어요." } }
      }
