      }
    },
    "onboarding.gettingStarted.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "How to get started" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이렇게 시작하세요" } }
      }
    },
    "onboarding.guide.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use the furniture button to check a sofa, bed, or desk, or ask for a route to an object. Guidance needs enough information about the floor and passages." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "가구 버튼으로 소파·침대·책상을 놓을 자리를 확인하거나 물건까지 길 안내를 요청해 보세요. 바닥과 통로 정보가 충분할 때 안내할 수 있어요." } }
      }
    },
    "onboarding.guide.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check furniture fit and routes" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "가구 배치와 길 안내" } }
      }
    },
    "onboarding.memory.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ask “Find my laptop.” Vispace distinguishes confirmed current locations from where an object was last seen." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“노트북 찾아줘”처럼 물어보세요. 현재 확인된 위치와 마지막으로 본 위치를 구분해 알려드려요." } }
      }
    },
