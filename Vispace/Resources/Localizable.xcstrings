      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By starting, you agree to on-device camera processing and local spatial-data storage. iOS will then ask for camera access."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작하면 기기 내 카메라 처리와 공간 데이터 저장에 동의하며, 이어서 카메라 접근 권한을 요청합니다."
          }
        }
      }
    },
    "onboarding.privacy.detail" : {
      "localizations" : {
        "en" : {
