{
  "sourceLanguage" : "en",
  "strings" : {
    "data.history.cleanup.action": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Clear removed-object history" } },
        "ko": { "stringUnit": { "state": "translated", "value": "삭제된 물체 이력 정리" } }
      }
    },
    "data.history.cleanup.confirm": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Permanently erase the locations and history of automatically recognized objects marked as removed in this place. Manual registrations and current, last-seen, or temporarily hidden objects stay saved. This cannot be undone." } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 장소에서 ‘삭제됨’으로 기록된 자동 인식 물체의 위치와 변경 이력을 영구적으로 지웁니다. 수동 등록한 물체와 현재·마지막 위치 기록, 잠시 보이지 않는 물체는 유지됩니다. 되돌릴 수 없습니다." } }
      }
    },
    "data.history.cleanup.progress": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Clearing removed-object history…" } },
        "ko": { "stringUnit": { "state": "translated", "value": "삭제된 물체 이력을 정리하고 있어요" } }
      }
    },
    "data.history.cleanup.success": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Removed-object history cleared." } },
        "ko": { "stringUnit": { "state": "translated", "value": "삭제된 물체 이력을 정리했어요." } }
      }
    },
    "data.history.cleanup.failed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "History cleanup could not finish. Try again." } },
        "ko": { "stringUnit": { "state": "translated", "value": "이력 정리를 마치지 못했어요. 다시 시도해 주세요." } }
      }
    },
    "data.place.checkpoint.bytes": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Map files" } },
        "ko": { "stringUnit": { "state": "translated", "value": "지도 파일" } }
      }
    },
    "data.place.checkpoint.older.bytes": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Older map files" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이전 지도 파일" } }
      }
    },
  "data.transfer.title": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Move a saved place"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "저장한 장소 옮기기"
        }
      }
    }
  },
  "data.transfer.export": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Export encrypted place"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "장소 암호화 내보내기"
        }
      }
    }
  },
  "data.transfer.import": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Import encrypted place"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "암호화된 장소 가져오기"
        }
      }
    }
  },
  "data.transfer.progress": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Checking and protecting place data…"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "장소 데이터를 확인하고 보호하고 있어요…"
        }
      }
    }
  },
  "data.transfer.import.success": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Place imported. Point the camera around the original space to restore it."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "장소를 가져왔어요. 원래 공간을 카메라로 비추면 복원할 수 있어요."
        }
      }
    }
  },
  "data.transfer.file.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The file could not be selected or saved. Check the Files location and try again."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "파일을 선택하거나 저장하지 못했어요. 파일 앱의 위치를 확인하고 다시 시도해 주세요."
        }
      }
    }
  },
  "data.transfer.scope": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Includes one latest saved map and current objects, including user names. Older checkpoints and change history are excluded; fingerprints and relations are rebuilt. No original camera frames are included. Supports maps up to 128 MiB and files up to 146 MiB. Automatic records are limited to 2,048; manual records also depend on available metadata storage."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "최신 지도 한 개와 현재 물체 기록·사용자 이름만 옮깁니다. 과거 체크포인트와 변경 이력은 포함하지 않으며, 장소 지문·관계는 다시 생성합니다. 원본 카메라 영상은 포함하지 않습니다. 지도는 128 MiB, 파일은 146 MiB까지 지원합니다. 자동 인식 기록은 2,048개까지이며, 직접 등록 기록은 메타데이터 저장 용량에 따라 달라집니다."
        }
      }
    }
  },
  "data.transfer.key.title": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Save your recovery key first"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "복구 키를 먼저 보관하세요"
        }
      }
    }
  },
  "data.transfer.key.detail": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Save this key separately in a safe place, such as a password manager. It is required to import the file and cannot be recovered by Vispace. Do not store or send the key together with the encrypted file. The key is cleared when this sheet closes."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 키를 비밀번호 관리자 등 별도의 안전한 곳에 보관하세요. 파일을 가져올 때 꼭 필요하며 Vispace에서 복구할 수 없습니다. 암호화 파일과 키를 함께 보관하거나 전송하지 마세요. 이 창을 닫으면 키가 지워집니다."
        }
      }
    }
  },
  "data.transfer.key.saved": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "I have saved the recovery key separately"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "복구 키를 별도로 보관했어요"
        }
      }
    }
  },
  "data.transfer.save": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Choose where to save the encrypted file"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "암호화 파일을 저장할 위치 선택"
        }
      }
    }
  },
  "data.transfer.key.input": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Recovery key"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "복구 키"
        }
      }
    }
  },
  "data.transfer.duplicate": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This place, coordinate frame or object is already stored. Import does not replace existing data."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "같은 장소·좌표계·물체가 이미 저장되어 있어요. 가져오기는 기존 데이터를 덮어쓰지 않습니다."
        }
      }
    }
  },
  "data.transfer.key.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The recovery key is incorrect, or the encrypted file has changed. Check the key and original file."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "복구 키가 맞지 않거나 암호화 파일이 변경됐어요. 키와 원본 파일을 확인해 주세요."
        }
      }
    }
  },
  "data.transfer.size.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This place exceeds a transfer limit: 128 MiB map, 146 MiB file, 16 MiB metadata, 65,536 total records, or 2,048 automatic records. Older files keep their original smaller limits."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "전송 한도를 초과해요. 지도 128 MiB, 파일 146 MiB, 메타데이터 16 MiB, 전체 기록 65,536개, 자동 인식 기록 2,048개까지 지원합니다. 이전 형식의 파일에는 기존 한도가 적용돼요."
        }
      }
    }
  },
  "data.transfer.version.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This file uses a newer or unsupported format. Update Vispace before importing. The file is unchanged."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "지원하지 않는 버전의 파일이에요. Vispace를 업데이트한 뒤 가져와 주세요. 원본 파일은 변경하지 않았어요."
        }
      }
    }
  },
  "data.transfer.invalid": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This file is not a valid Vispace place, or the selected place is unavailable. Existing data is preserved."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "유효한 Vispace 장소 파일이 아니거나 선택한 장소를 불러올 수 없어요. 기존 데이터는 보존됩니다."
        }
      }
    }
  },
  "data.transfer.storage.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Storage is unavailable or too full. Check free space and retry; existing places are preserved."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "저장공간에 접근할 수 없거나 공간이 부족해요. 여유 공간을 확인하고 다시 시도해 주세요. 기존 장소는 보존됩니다."
        }
      }
    }
  },
  "data.transfer.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Place transfer could not be completed. Check the file, recovery key and storage, then retry."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "장소를 옮기지 못했어요. 파일·복구 키·저장공간을 확인한 뒤 다시 시도해 주세요."
        }
      }
    }
  },
  "data.transfer.recovery.required": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "An existing recovery copy was found. Reopen Vispace to restore the saved catalog before importing."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "기존 복구본이 남아 있어요. Vispace를 다시 열어 저장 목록을 복구한 뒤 가져와 주세요."
        }
      }
    }
  },
    "storage.restore.failed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Saved space could not be restored. Existing files are preserved. Check storage and the app version, then reopen the app to retry." } },
        "ko": { "stringUnit": { "state": "translated", "value": "저장된 공간을 불러오지 못했어요. 기존 파일은 보존됩니다. 저장 공간과 앱 버전을 확인한 뒤 앱을 다시 열어 주세요." } }
      }
    },
    "storage.save.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Spatial data could not be saved. Open storage settings, free some space and retry scanning."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "공간 정보를 저장하지 못했어요. 저장공간을 확인하고 정리한 뒤 다시 스캔해 주세요."
        }
      }
    }
  },
  "storage.objects.full": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Object memory is full. Existing objects still update. Manage saved places to add new objects."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "물체 기록이 가득 찼어요. 기존 물체는 계속 갱신됩니다. 새 물체를 추가하려면 장소를 정리해 주세요."
        }
      }
    }
  },
  "placement.dimensions.title": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Furniture dimensions"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "가구 실측 치수"
        }
      }
    }
  },
  "placement.dimensions.metres": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Dimensions in metres"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "치수 입력 단위 m"
        }
      }
    }
  },
  "placement.dimensions.detail": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Enter the actual product dimensions, between 0.1 and 10 metres. Initial values are examples."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "실제 제품의 치수를 0.1~10m 범위로 입력해 주세요. 처음 표시된 값은 예시입니다."
        }
      }
    }
  },
  "placement.width": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Width"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "너비"
        }
      }
    }
  },
  "placement.depth": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Depth"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "깊이"
        }
      }
    }
  },
  "placement.height": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Height"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "높이"
        }
      }
    }
  },
  "placement.evaluate": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Check placement"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "배치 확인"
        }
      }
    }
  },
  "data.storage.usage": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Storage usage"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "저장공간 사용량"
        }
      }
    }
  },
  "data.storage.used": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Used by Vispace"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "Vispace 사용량"
        }
      }
    }
  },
  "data.storage.available": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Device space available"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "기기 여유 공간"
        }
      }
    }
  },
  "data.storage.budget": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Spatial storage is limited to 512 MB. Saving preserves at least 128 MB of device free space."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "공간 데이터는 최대 512MB로 관리하며, 저장 시 기기 여유 공간 128MB를 확보합니다."
        }
      }
    }
  },
  "data.places.title": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Saved places"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "저장된 장소"
        }
      }
    }
  },
  "data.place.delete": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Delete this place"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 장소 삭제"
        }
      }
    }
  },
  "data.place.delete.detail": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This removes the selected map, objects, history and related alignments. Other places remain available. Use Delete All to also remove unreadable recovery files."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "선택한 지도의 물체, 이력, 관련 좌표 연결을 함께 삭제합니다. 다른 장소는 유지합니다. 해석할 수 없는 복구 파일까지 지우려면 전체 삭제를 이용해 주세요."
        }
      }
    }
  },
  "data.place.select": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Restore this place"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 장소 복원"
        }
      }
    }
  },
  "data.place.select.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This place could not be restored. Check its saved data and try again."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "장소를 복원하지 못했어요. 저장된 데이터를 확인하고 다시 시도해 주세요."
        }
      }
    }
  },
  "data.storage.read.failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Saved data could not be read. A newer app version may be required; keep the data until its version is checked."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "저장된 데이터를 읽지 못했어요. 더 최신 앱이 필요할 수 있으니 버전을 확인하기 전에는 데이터를 보존해 주세요."
        }
      }
    }
  },
  "data.support.title": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Supported features"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "지원 범위"
        }
      }
    }
  },
  "data.support.objects": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Automatic detection supports 80 model classes, including keyboards, mice, monitors, tables and chairs. Each class has Korean and English search names. For other objects, such as keys, wallets and speakers, point at the object and register its name and last-seen location. Register the new location again after moving it."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "키보드, 마우스, 모니터, 테이블, 의자 등 모델의 80개 종류를 자동 인식하며 한국어와 영어로 검색할 수 있습니다. 열쇠, 지갑, 스피커 등 그 외 물체는 직접 비춘 뒤 이름과 마지막 확인 위치를 등록할 수 있습니다. 옮긴 뒤에는 새 위치를 다시 등록해 주세요."
        }
      }
    }
  },
  "data.support.device": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Saving new 3D objects requires verified depth. Placement and route guidance require LiDAR."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "새 3D 물체 저장에는 검증된 깊이 정보가 필요합니다. 배치와 경로 안내에는 LiDAR가 필요합니다."
        }
      }
    }
  },
  "data.support.routes": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Guidance covers observed indoor floors only. Doors, steps, stairs and unseen areas can prevent a route. Keep checking your surroundings."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "관측한 실내 바닥에서 안내합니다. 문, 단차, 계단, 보이지 않는 구역에서는 경로가 제공되지 않을 수 있습니다. 주변을 직접 확인해 주세요."
        }
      }
    }
  },
    "command.empty" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter an object or a placement question." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "찾을 물건이나 배치할 가구를 입력해 주세요." } }
      }
    },
    "command.tooLong" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your request within 256 characters." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "요청을 256자 이내로 입력해 주세요." } }
      }
    },
    "command.ambiguousFurniture" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose one furniture item to check at a time." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한 번에 가구 하나를 선택해 배치를 확인해 주세요." } }
      }
    },
    "command.negatedPlacement" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No placement was started. Use the furniture menu when you want to check a position." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "배치를 실행하지 않았어요. 위치를 확인하려면 가구 메뉴에서 하나를 선택해 주세요." } }
      }
    },
    "command.unsupportedFurniture" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Placement checks currently support sofas, beds and desks." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 배치 확인은 소파, 침대, 책상을 지원해요." } }
      }
    },
    "storage.unavailable.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Spatial storage is unavailable" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공간 데이터를 안전하게 저장할 수 없어요" } }
