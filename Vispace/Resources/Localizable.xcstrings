      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic object recognition and automatic spatial-memory updates are unavailable. Saved-space search and data management remain available; results that require current object evidence may be unavailable." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "물체 자동 인식과 공간 기억 자동 갱신을 사용할 수 없어요. 저장된 공간 검색과 데이터 관리는 계속 사용할 수 있지만, 현재 물체 정보가 필요한 결과는 제공되지 않을 수 있어요." } }
